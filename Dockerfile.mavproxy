FROM python:3.9-slim-bookworm

USER root

# 1. Налаштовуємо мовні локалі для захисту від помилок кодування в Pip
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV AUTOTEST_HEADLESS=1

# 2. Встановлюємо Python 3.9, системні залежності розробника, утиліту мережі `ip` та SOCAT
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
    iproute2 procps && \
    rm -rf /var/lib/apt/lists/* 
    
# 3. Оновлюємо pip та встановлюємо суворі версії бібліотек під Python 3.9
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir --no-compile --break-system-packages \
    pymavlink \
    mavproxy==1.8.70

EXPOSE 14550/udp

ENTRYPOINT ["mavproxy.py"]

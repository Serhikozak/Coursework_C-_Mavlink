FROM ubuntu:22.04 AS builder

USER root
WORKDIR /ardupilot

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    python3 \
    python3-pip \
    python3-setuptools \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir empy==3.3.4 pexpect

#RUN git config --global --add safe.directory /ardupilot 

RUN git init . && \
    git remote add origin https://github.com/ArduPilot/ardupilot.git && \
    git fetch --depth 1 origin master && \
    git checkout FETCH_HEAD && \
    git submodule update --init --recursive --depth 1 \
    modules/waf modules/gtest modules/littlefs modules/ChibiOS modules/DroneCAN modules/lwip 
    
RUN ./waf configure --board sitl && ./waf copter


FROM python:3.9-slim-bookworm

USER root
WORKDIR /ardupilot
    
# 1. Налаштовуємо мовні локалі для захисту від помилок кодування в Pip
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV AUTOTEST_HEADLESS=1

# 2. Встановлюємо Python 3.9, системні залежності розробника та утиліту мережі `ip`

RUN apt-get update && apt-get install -y --no-install-recommends \
    iproute2 \
    sudo \
    socat \
    procps \
    && rm -rf /var/lib/apt/lists/*

# 3. Оновлюємо pip та встановлюємо суворі версії бібліотек під Python 3.9
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install --no-cache-dir --no-compile --break-system-packages \
    empy==3.3.4 \
    pymavlink \
    pexpect \
    future \
    mavproxy==1.8.70

#RUN git config --global --add safe.directory /ardupilot

COPY --from=builder /ardupilot/build/sitl/bin/arducopter /ardupilot/arducopter
COPY --from=builder /ardupilot/Tools/autotest/default_params/copter.parm /ardupilot/copter.parm
EXPOSE 5760 14550
# 5. Прописуємо системні шляхи для бінарників
ENV PATH=/ardupilot:$PATH

#CMD ["arducopter", "-S", "model", "--speedup", "1", "--defaults", "/ardupilot/copter.parm"]